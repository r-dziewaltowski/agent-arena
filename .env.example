# SQLite database (libsql). Use forward slashes on Windows too.
DATABASE_URL=file:./data/arena.db
# Only for a Turso database (DATABASE_URL=libsql://…)
# DATABASE_AUTH_TOKEN=

# Ollama (local development)
OLLAMA_BASE_URL=http://127.0.0.1:11434/api
OLLAMA_DEFAULT_MODEL=llama3.2

# Groq free tier (use an account with no payment method, so it can never be billed)
GROQ_API_KEY=
GROQ_DEFAULT_MODEL=openai/gpt-oss-120b

# Better Auth: a random secret of 32+ characters that signs login sessions (see the README)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Optional: "Continue with GitHub" (shown only when both are set)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Job queue (Upstash QStash). Locally: the dev server that `npm run dev` starts in Docker;
# copy the token and both signing keys from `docker logs agent-arena-qstash`.
QSTASH_URL=http://127.0.0.1:8080
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
# Optional. Where the queue calls the app; locally defaults to http://host.docker.internal:3000
# APP_URL=
# Optional. How many turns may run at once (default 1 locally, 2 in production)
# TURN_PARALLELISM=

# Email (confirming addresses, resetting passwords). Leave empty locally: emails are then
# printed in the terminal, links included. Production needs both (see the README).
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Optional. Also append each unsent email to this file (the end-to-end tests read links from it).
# EMAIL_OUTBOX_FILE=

# Google free tier: Gemini Flash-Lite (an AI Studio key whose project has no billing)
GOOGLE_GENERATIVE_AI_API_KEY=

# Optional. Live updates through Ably ("appId.keyId:secret", a key that can publish and subscribe).
# Without it, the app's own event stream serves them locally, and Vercel deployments poll.
# ABLY_API_KEY=
# Optional. "off" turns pushed updates off: pages poll.
# REALTIME=