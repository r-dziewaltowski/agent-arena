{
  "name": "agent-arena",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "tsx scripts/migrate.ts",
    "dev": "concurrently --kill-others --names web,queue --prefix-colors blue,magenta \"next dev\" \"tsx scripts/queue-dev.ts\"",
    "dev:web": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "db:seed-dev": "tsx scripts/seed-dev-accounts.ts",
    "email:check": "tsx scripts/check-email.ts",
    "debate:cli": "tsx scripts/debate-cli.ts",
    "queue:dev": "tsx scripts/queue-dev.ts",
    "queue:setup": "tsx scripts/setup-queue.ts",
    "vercel-build": "tsx scripts/deploy-setup.ts && next build",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@ai-sdk/groq": "^4.0.84",
    "@libsql/client": "^0.18.0",
    "@upstash/qstash": "^2.12.2",
    "ai": "^7.0.173",
    "better-auth": "^1.7.25",
    "drizzle-orm": "^0.45.4",
    "next": "16.4.6",
    "nodemailer": "^10.6.0",
    "ollama-ai-provider-v2": "^4.1.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^24.19.2",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.7",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.0"
  }
}
